# =========================================================
# Intelligent Power Consumption Analyzer - Environment Variables
# =========================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to GitHub!

# --- Backend ---
# MongoDB Atlas connection string
# Get this from: MongoDB Atlas > Clusters > Connect > Connect your application
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/college_energy?retryWrites=true&w=majority

# Port for the Express backend server
PORT=5000

# Node environment (development | production)
NODE_ENV=development

# --- Frontend (Vite) ---
# URL of your running backend API
# In development: http://localhost:5000
# In production: your deployed backend URL
VITE_API_URL=http://localhost:5000
